# Copy to .env on the GPU host. Do not commit .env or an access token.
# Use an immutable image digest or a pinned release tag after compatibility testing.
VLLM_IMAGE=vllm/vllm-openai@sha256:REPLACE_WITH_VERIFIED_DIGEST
MODEL_ID=Qwen/Qwen2.5-7B-Instruct
# Set this to a full Hugging Face commit SHA, not a branch name.
MODEL_REVISION=REPLACE_WITH_MODEL_COMMIT_SHA
SERVED_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VLLM_PORT=8000
HF_CACHE_DIR=./.cache/huggingface

# Choose one explicit configuration before `docker compose up`.
# A: --no-enable-prefix-caching --no-enable-chunked-prefill --max-model-len 16384 --max-num-batched-tokens 16384 --max-num-seqs 32 --gpu-memory-utilization 0.90
# B: --enable-prefix-caching --no-enable-chunked-prefill --max-model-len 16384 --max-num-batched-tokens 16384 --max-num-seqs 32 --gpu-memory-utilization 0.90
# C: --no-enable-prefix-caching --enable-chunked-prefill --max-model-len 16384 --max-num-batched-tokens 16384 --max-num-seqs 32 --gpu-memory-utilization 0.90
# D: --enable-prefix-caching --enable-chunked-prefill --max-model-len 16384 --max-num-batched-tokens 16384 --max-num-seqs 32 --gpu-memory-utilization 0.90
# E: leave blank for the engine-default reference after setting only required model/server values.
VLLM_ARGS=--enable-prefix-caching --enable-chunked-prefill --max-model-len 16384 --max-num-batched-tokens 16384 --max-num-seqs 32 --gpu-memory-utilization 0.90

# Required only for gated Hugging Face models.
# HF_TOKEN=
